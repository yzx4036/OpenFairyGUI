{
	"name": "@openfairygui/codegen",
	"version": "0.3.1",
	"description": "Framework-agnostic template code generation utilities for OpenFairyGUI.",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
		"directory": "packages/codegen"
	},
	"homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
	"bugs": {
		"url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts --format esm,cjs --platform neutral --dts",
		"build:watch": "tsdown src/index.ts --format esm,cjs --platform neutral --dts --watch",
		"test": "ava --no-worker-threads",
		"lint": "biome check src test --formatter-enabled=false --assist-enabled=false"
	},
	"files": [
		"dist/",
		"src/"
	],
	"keywords": [
		"fairygui",
		"codegen",
		"template",
		"csharp"
	],
	"devDependencies": {
		"ava": "^7.0.0",
		"tsx": "^4.0.0"
	},
	"ava": {
		"extensions": {
			"ts": "module"
		},
		"nodeArguments": [
			"--import",
			"tsx/esm"
		],
		"files": [
			"test/**/*.test.ts"
		]
	}
}
